<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Studio — Sanzeet Photography</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

    <style>
        /* =====================================================
           RESET
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #080a08;
            color: #f1f0e9;
            font-family: "DM Sans", sans-serif;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =====================================================
           APP
        ===================================================== */

        .admin-app {
            min-height: 100vh;
            display: flex;
        }

        /* =====================================================
           SIDEBAR
        ===================================================== */

        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            background: #0d100d;
            border-right: 1px solid rgba(255,255,255,.08);
            padding: 28px 18px;
            z-index: 100;
            display: flex;
            flex-direction: column;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px;
            margin-bottom: 45px;
            text-decoration: none;
            color: white;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-family: "Playfair Display", serif;
            font-size: 20px;
        }

        .brand-text {
            font-size: 12px;
            letter-spacing: .22em;
            font-weight: 700;
        }

        .sidebar-label {
            padding: 0 10px;
            color: rgba(255,255,255,.28);
            font-size: 9px;
            letter-spacing: .22em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .side-nav {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .side-link {
            width: 100%;
            border: 0;
            background: transparent;
            color: rgba(255,255,255,.52);
            text-align: left;
            padding: 13px 12px;
            border-radius: 9px;
            font-size: 12px;
            transition: .25s;
        }

        .side-link:hover,
        .side-link.active {
            color: white;
            background: rgba(255,255,255,.07);
        }

        .side-link.active {
            border-left: 2px solid #b6d38b;
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .admin-user {
            padding: 15px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px;
            background: rgba(255,255,255,.025);
            margin-bottom: 10px;
        }

        .admin-user small {
            display: block;
            color: rgba(255,255,255,.35);
            font-size: 9px;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: .14em;
        }

        .admin-user span {
            display: block;
            font-size: 11px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .logout-btn {
            width: 100%;
            border: 1px solid rgba(255,255,255,.1);
            background: transparent;
            color: rgba(255,255,255,.6);
            border-radius: 9px;
            padding: 11px;
            font-size: 11px;
            transition: .25s;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,.07);
            color: white;
        }

        /* =====================================================
           MAIN
        ===================================================== */

        .main {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 34px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 38px;
        }

        .page-eyebrow {
            color: #b6d38b;
            text-transform: uppercase;
            letter-spacing: .2em;
            font-size: 9px;
            margin-bottom: 10px;
        }

        .page-title {
            margin: 0;
            font-family: "Playfair Display", serif;
            font-size: clamp(32px, 4vw, 55px);
            font-weight: 500;
            letter-spacing: -.04em;
        }

        .site-link {
            text-decoration: none;
            color: rgba(255,255,255,.65);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 999px;
            padding: 11px 16px;
            font-size: 10px;
            transition: .25s;
        }

        .site-link:hover {
            background: white;
            color: #080a08;
        }

        /* =====================================================
           SECTIONS
        ===================================================== */

        .admin-section {
            display: none;
            animation: fadeUp .45s ease;
        }

        .admin-section.active {
            display: block;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =====================================================
           STAT CARDS
        ===================================================== */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 28px;
        }

        .stat-card {
            min-height: 150px;
            padding: 22px;
            border: 1px solid rgba(255,255,255,.08);
            background:
                radial-gradient(circle at top right, rgba(182,211,139,.08), transparent 45%),
                #0d100d;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .stat-label {
            color: rgba(255,255,255,.4);
            font-size: 9px;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

        .stat-number {
            font-family: "Playfair Display", serif;
            font-size: 43px;
            font-weight: 500;
        }

        .stat-note {
            color: rgba(255,255,255,.3);
            font-size: 9px;
        }

        /* =====================================================
           PANELS
        ===================================================== */

        .panel {
            background: #0d100d;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 22px;
        }

        .panel-title {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
        }

        .panel-subtitle {
            color: rgba(255,255,255,.35);
            font-size: 10px;
            margin-top: 5px;
        }

        /* =====================================================
           UPLOAD
        ===================================================== */

        .upload-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 20px;
        }

        .dropzone {
            min-height: 400px;
            border: 1px dashed rgba(255,255,255,.18);
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 35px;
            transition: .3s;
            background:
                radial-gradient(circle, rgba(182,211,139,.06), transparent 55%);
        }

        .dropzone.dragover {
            border-color: #b6d38b;
            background: rgba(182,211,139,.08);
        }

        .upload-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.14);
            display: grid;
            place-items: center;
            font-size: 26px;
            margin-bottom: 20px;
        }

        .dropzone h3 {
            margin: 0 0 8px;
            font-family: "Playfair Display", serif;
            font-size: 26px;
            font-weight: 500;
        }

        .dropzone p {
            margin: 0;
            color: rgba(255,255,255,.4);
            font-size: 11px;
            line-height: 1.7;
            max-width: 350px;
        }

        .choose-btn {
            margin-top: 22px;
            border: 0;
            background: #f1f0e9;
            color: #080a08;
            padding: 12px 19px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 600;
        }

        #photoInput {
            display: none;
        }

        .preview-area {
            display: none;
            margin-top: 20px;
        }

        .preview-area.show {
            display: block;
        }

        .preview-image {
            width: 100%;
            max-height: 250px;
            object-fit: contain;
            border-radius: 10px;
            background: #080a08;
        }

        /* =====================================================
           FORM
        ===================================================== */

        .form-group {
            margin-bottom: 17px;
        }

        .form-label {
            display: block;
            color: rgba(255,255,255,.45);
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .14em;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1px solid rgba(255,255,255,.1);
            outline: none;
            background: rgba(255,255,255,.04);
            color: white;
            border-radius: 8px;
            padding: 12px 13px;
            font-size: 12px;
        }

        .form-control:focus {
            border-color: rgba(182,211,139,.6);
        }

        textarea.form-control {
            min-height: 100px;
            resize: vertical;
            line-height: 1.6;
        }

        select.form-control option {
            background: #101310;
            color: white;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 9px;
            background: rgba(255,255,255,.025);
        }

        .checkbox-row input {
            accent-color: #b6d38b;
        }

        .checkbox-row span {
            font-size: 11px;
            color: rgba(255,255,255,.65);
        }

        .publish-btn {
            width: 100%;
            border: 0;
            background: #b6d38b;
            color: #10130f;
            padding: 14px;
            border-radius: 9px;
            font-size: 11px;
            font-weight: 700;
            margin-top: 5px;
            transition: .25s;
        }

        .publish-btn:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

        .publish-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }

        /* =====================================================
           LIBRARY
        ===================================================== */

        .library-tools {
            display: flex;
            gap: 10px;
        }

        .library-search {
            min-width: 240px;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 999px;
            color: white;
            padding: 10px 15px;
            outline: none;
            font-size: 11px;
        }

        .library-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .photo-item {
            background: #080a08;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 10px;
            overflow: hidden;
        }

        .photo-image-wrap {
            position: relative;
            aspect-ratio: 1 / 1;
            overflow: hidden;
        }

        .photo-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .featured-badge {
            position: absolute;
            top: 9px;
            left: 9px;
            background: #b6d38b;
            color: #0b0d0b;
            padding: 6px 9px;
            border-radius: 999px;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .1em;
        }

        .photo-details {
            padding: 13px;
        }

        .photo-name {
            font-family: "Playfair Display", serif;
            font-size: 18px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .photo-category {
            color: #b6d38b;
            text-transform: uppercase;
            font-size: 8px;
            letter-spacing: .14em;
            margin-top: 4px;
        }

        .photo-stats {
            display: flex;
            gap: 12px;
            color: rgba(255,255,255,.35);
            font-size: 9px;
            margin-top: 10px;
        }

        .photo-actions {
            display: flex;
            gap: 6px;
            margin-top: 12px;
        }

        .small-btn {
            flex: 1;
            border: 1px solid rgba(255,255,255,.1);
            background: transparent;
            color: rgba(255,255,255,.6);
            border-radius: 7px;
            padding: 8px 5px;
            font-size: 9px;
        }

        .small-btn:hover {
            background: rgba(255,255,255,.07);
            color: white;
        }

        .delete-btn:hover {
            border-color: rgba(255,100,100,.4);
            color: #ff9b9b;
        }

        /* =====================================================
           ANALYTICS
        ===================================================== */

        .analytics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .metric-large {
            font-family: "Playfair Display", serif;
            font-size: 50px;
            margin-top: 15px;
        }

        .category-row {
            display: grid;
            grid-template-columns: 100px 1fr 50px;
            align-items: center;
            gap: 10px;
            margin: 15px 0;
        }

        .category-name {
            font-size: 10px;
            color: rgba(255,255,255,.5);
            text-transform: uppercase;
        }

        .bar {
            height: 5px;
            background: rgba(255,255,255,.07);
            border-radius: 99px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            width: 0;
            background: #b6d38b;
            border-radius: inherit;
            transition: width 1s ease;
        }

        .category-number {
            text-align: right;
            font-size: 10px;
            color: rgba(255,255,255,.45);
        }

        /* =====================================================
           TOAST
        ===================================================== */

        .toast {
            position: fixed;
            right: 25px;
            bottom: 25px;
            z-index: 1000;
            max-width: 330px;
            background: #f1f0e9;
            color: #0a0d0a;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 11px;
            transform: translateY(100px);
            opacity: 0;
            transition: .35s;
            pointer-events: none;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* =====================================================
           LOADING
        ===================================================== */

        .loading {
            text-align: center;
            padding: 60px;
            color: rgba(255,255,255,.35);
            font-size: 10px;
            letter-spacing: .15em;
        }

        /* =====================================================
           MOBILE
        ===================================================== */

        .mobile-topbar {
            display: none;
        }

        @media (max-width: 1100px) {

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .library-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .upload-layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 750px) {

            .sidebar {
                transform: translateX(-100%);
                transition: .3s;
            }

            body.sidebar-open .sidebar {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
                width: 100%;
                padding: 20px;
                padding-top: 80px;
            }

            .mobile-topbar {
                position: fixed;
                display: flex;
                justify-content: space-between;
                align-items: center;
                top: 0;
                left: 0;
                right: 0;
                height: 60px;
                padding: 0 18px;
                background: rgba(8,10,8,.88);
                backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255,255,255,.08);
                z-index: 90;
            }

            .mobile-brand {
                font-size: 11px;
                letter-spacing: .18em;
                font-weight: 700;
            }

            .mobile-menu {
                border: 1px solid rgba(255,255,255,.15);
                background: transparent;
                color: white;
                border-radius: 7px;
                padding: 7px 10px;
                font-size: 9px;
            }

            .topbar {
                align-items: flex-start;
            }

            .site-link {
                display: none;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .stat-card {
                min-height: 125px;
            }

            .stat-number {
                font-size: 34px;
            }

            .panel {
                padding: 18px;
            }

            .panel-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .library-tools {
                width: 100%;
            }

            .library-search {
                width: 100%;
                min-width: 0;
            }

            .library-grid {
                grid-template-columns: 1fr 1fr;
            }

            .analytics-grid {
                grid-template-columns: 1fr;
            }

            .two-col {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 430px) {

            .main {
                padding: 15px;
                padding-top: 75px;
            }

            .stats-grid {
                gap: 8px;
            }

            .stat-card {
                padding: 15px;
                min-height: 110px;
            }

            .stat-number {
                font-size: 29px;
            }

            .library-grid {
                gap: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- MOBILE TOPBAR -->
    <div class="mobile-topbar">
        <div class="mobile-brand">
            SANZEET · STUDIO
        </div>

        <button class="mobile-menu" id="mobileMenu">
            MENU
        </button>
    </div>


    <div class="admin-app">

        <!-- =================================================
             SIDEBAR
        ================================================== -->

        <aside class="sidebar" id="sidebar">

            <a href="index.html" class="brand">
                <span class="brand-mark">S</span>
                <span class="brand-text">SANZEET</span>
            </a>

            <div class="sidebar-label">
                Studio
            </div>

            <nav class="side-nav">

                <button class="side-link active" data-section="dashboard">
                    ◉ &nbsp; Overview
                </button>

                <button class="side-link" data-section="upload">
                    ＋ &nbsp; Upload Frame
                </button>

                <button class="side-link" data-section="library">
                    ▦ &nbsp; Photo Library
                </button>

                <button class="side-link" data-section="analytics">
                    ◒ &nbsp; Analytics
                </button>

            </nav>


            <div class="sidebar-bottom">

                <div class="admin-user">
                    <small>Signed in as</small>
                    <span id="adminEmail">
                        Checking...
                    </span>
                </div>

                <button class="logout-btn" id="logoutBtn">
                    LOG OUT
                </button>

            </div>

        </aside>


        <!-- =================================================
             MAIN
        ================================================== -->

        <main class="main">

            <div class="topbar">

                <div>
                    <div class="page-eyebrow">
                        Sanzeet Photography · Studio
                    </div>

                    <h1 class="page-title" id="pageTitle">
                        Overview
                    </h1>
                </div>

                <a href="index.html" class="site-link">
                    VIEW WEBSITE ↗
                </a>

            </div>


            <!-- =================================================
                 DASHBOARD
            ================================================== -->

            <section
                class="admin-section active"
                id="section-dashboard"
            >

                <div class="stats-grid">

                    <div class="stat-card">
                        <div class="stat-label">
                            Total Frames
                        </div>

                        <div class="stat-number" id="totalPhotos">
                            0
                        </div>

                        <div class="stat-note">
                            Published photographs
                        </div>
                    </div>


                    <div class="stat-card">
                        <div class="stat-label">
                            Total Views
                        </div>

                        <div class="stat-number" id="totalViews">
                            0
                        </div>

                        <div class="stat-note">
                            Viewer interactions
                        </div>
                    </div>


                    <div class="stat-card">
                        <div class="stat-label">
                            Downloads
                        </div>

                        <div class="stat-number" id="totalDownloads">
                            0
                        </div>

                        <div class="stat-note">
                            HD downloads
                        </div>
                    </div>


                    <div class="stat-card">
                        <div class="stat-label">
                            Featured
                        </div>

                        <div class="stat-number" id="featuredPhotos">
                            0
                        </div>

                        <div class="stat-note">
                            Signature frames
                        </div>
                    </div>

                </div>


                <div class="panel">

                    <div class="panel-head">

                        <div>
                            <h2 class="panel-title">
                                Latest Frames
                            </h2>

                            <div class="panel-subtitle">
                                Recently added photographs
                            </div>
                        </div>

                        <button
                            class="small-btn"
                            id="goUpload"
                        >
                            + NEW FRAME
                        </button>

                    </div>

                    <div
                        class="library-grid"
                        id="latestGrid"
                    >
                        <div class="loading">
                            LOADING...
                        </div>
                    </div>

                </div>

            </section>


            <!-- =================================================
                 UPLOAD
            ================================================== -->

            <section
                class="admin-section"
                id="section-upload"
            >

                <div class="upload-layout">

                    <!-- DROPZONE -->

                    <div class="panel">

                        <div class="panel-head">

                            <div>
                                <h2 class="panel-title">
                                    Add New Frame
                                </h2>

                                <div class="panel-subtitle">
                                    Upload a photograph to the field archive
                                </div>
                            </div>

                        </div>


                        <div
                            class="dropzone"
                            id="dropzone"
                        >

                            <div class="upload-icon">
                                ↑
                            </div>

                            <h3>
                                Drop your frame here
                            </h3>

                            <p>
                                JPG, JPEG, PNG or WEBP.
                                Choose a high-quality original for
                                the best viewing experience.
                            </p>

                            <button
                                class="choose-btn"
                                id="choosePhoto"
                                type="button"
                            >
                                CHOOSE PHOTO
                            </button>

                            <input
                                type="file"
                                id="photoInput"
                                accept="image/jpeg,image/png,image/webp"
                            >

                            <div
                                class="preview-area"
                                id="previewArea"
                            >
                                <img
                                    id="previewImage"
                                    class="preview-image"
                                    alt="Preview"
                                >
                            </div>

                        </div>

                    </div>


                    <!-- METADATA FORM -->

                    <div class="panel">

                        <div class="panel-head">

                            <div>
                                <h2 class="panel-title">
                                    Frame Details
                                </h2>

                                <div class="panel-subtitle">
                                    Tell the story behind the photograph
                                </div>
                            </div>

                        </div>


                        <form id="uploadForm">

                            <div class="form-group">

                                <label class="form-label">
                                    Title
                                </label>

                                <input
                                    class="form-control"
                                    id="photoTitle"
                                    type="text"
                                    placeholder="e.g. Into the Silence"
                                    maxlength="100"
                                >

                            </div>


                            <div class="form-group">

                                <label class="form-label">
                                    Category
                                </label>

                                <select
                                    class="form-control"
                                    id="photoCategory"
                                    required
                                >

                                    <option value="">
                                        Select category
                                    </option>

                                    <option value="wildlife">
                                        Wildlife
                                    </option>

                                    <option value="birds">
                                        Birds
                                    </option>

                                    <option value="nature">
                                        Nature
                                    </option>

                                    <option value="forest">
                                        Forest
                                    </option>

                                    <option value="mountains">
                                        Mountains
                                    </option>

                                    <option value="river">
                                        River
                                    </option>

                                    <option value="flower">
                                        Flower
                                    </option>

                                    <option value="aesthetic">
                                        Aesthetic
                                    </option>

                                    <option value="earth">
                                        Earth
                                    </option>

                                    <option value="ocean">
                                        Ocean
                                    </option>

                                </select>

                            </div>


                            <div class="two-col">

                                <div class="form-group">

                                    <label class="form-label">
                                        Location
                                    </label>

                                    <input
                                        class="form-control"
                                        id="photoLocation"
                                        type="text"
                                        placeholder="Jharkhand"
                                    >

                                </div>


                                <div class="form-group">

                                    <label class="form-label">
                                        Year
                                    </label>

                                    <input
                                        class="form-control"
                                        id="photoYear"
                                        type="text"
                                        placeholder="2026"
                                    >

                                </div>

                            </div>


                            <div class="form-group">

                                <label class="form-label">
                                    Story / Photographer Note
                                </label>

                                <textarea
                                    class="form-control"
                                    id="photoStory"
                                    placeholder="What happened behind this frame?"
                                ></textarea>

                            </div>


                            <div class="form-group">

                                <label class="checkbox-row">

                                    <input
                                        type="checkbox"
                                        id="featuredPhoto"
                                    >

                                    <span>
                                        Add this frame to Signature Work
                                    </span>

                                </label>

                            </div>


                            <button
                                class="publish-btn"
                                type="submit"
                                id="publishBtn"
                            >
                                PUBLISH FRAME
                            </button>

                        </form>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 LIBRARY
            ================================================== -->

            <section
                class="admin-section"
                id="section-library"
            >

                <div class="panel">

                    <div class="panel-head">

                        <div>
                            <h2 class="panel-title">
                                Photo Library
                            </h2>

                            <div class="panel-subtitle">
                                Manage every published frame
                            </div>
                        </div>

                        <div class="library-tools">

                            <input
                                class="library-search"
                                id="librarySearch"
                                type="search"
                                placeholder="Search frames..."
                            >

                        </div>

                    </div>


                    <div
                        class="library-grid"
                        id="libraryGrid"
                    >

                        <div class="loading">
                            LOADING LIBRARY...
                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 ANALYTICS
            ================================================== -->

            <section
                class="admin-section"
                id="section-analytics"
            >

                <div class="analytics-grid">

                    <div class="panel">

                        <div class="panel-title">
                            Total Views
                        </div>

                        <div
                            class="metric-large"
                            id="analyticsViews"
                        >
                            0
                        </div>

                        <div class="panel-subtitle">
                            Across the entire archive
                        </div>

                    </div>


                    <div class="panel">

                        <div class="panel-title">
                            Total Downloads
                        </div>

                        <div
                            class="metric-large"
                            id="analyticsDownloads"
                        >
                            0
                        </div>

                        <div class="panel-subtitle">
                            HD download activity
                        </div>

                    </div>

                </div>


                <div class="panel">

                    <div class="panel-head">

                        <div>
                            <h2 class="panel-title">
                                Collection Breakdown
                            </h2>

                            <div class="panel-subtitle">
                                Frames by category
                            </div>
                        </div>

                    </div>

                    <div id="categoryAnalytics">
                        <div class="loading">
                            CALCULATING...
                        </div>
                    </div>

                </div>

            </section>

        </main>

    </div>


    <!-- TOAST -->
    <div
        class="toast"
        id="toast"
    ></div>


    <!-- FIREBASE -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>


    <script>

        /* =====================================================
           FIREBASE
        ===================================================== */

        const firebaseConfig = {
            apiKey: "AIzaSyBmNYT07wtBxRdMmVgubRWUPEY3H6DQ608",
            authDomain: "sanzeet-photography.firebaseapp.com",
            projectId: "sanzeet-photography",
            storageBucket: "sanzeet-photography.firebasestorage.app",
            messagingSenderId: "307593623383",
            appId: "1:307593623383:web:ebc7de8415ce57703cf012",
            measurementId: "G-DHQVQF0D6Y"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }

        const auth = firebase.auth();
        const db = firebase.firestore();


        /* =====================================================
           CLOUDINARY
        ===================================================== */

        const CLOUDINARY_URL =
            "https://api.cloudinary.com/v1_1/dijtjmuxq/image/upload";

        const CLOUDINARY_PRESET =
            "sanzeet_upload";


        /* =====================================================
           STATE
        ===================================================== */

        let photos = [];
        let selectedFile = null;


        /* =====================================================
           DOM
        ===================================================== */

        const sideLinks =
            document.querySelectorAll(".side-link");

        const sections =
            document.querySelectorAll(".admin-section");

        const pageTitle =
            document.getElementById("pageTitle");

        const toast =
            document.getElementById("toast");

        const photoInput =
            document.getElementById("photoInput");

        const choosePhoto =
            document.getElementById("choosePhoto");

        const dropzone =
            document.getElementById("dropzone");

        const previewArea =
            document.getElementById("previewArea");

        const previewImage =
            document.getElementById("previewImage");

        const uploadForm =
            document.getElementById("uploadForm");

        const publishBtn =
            document.getElementById("publishBtn");

        const librarySearch =
            document.getElementById("librarySearch");


        /* =====================================================
           AUTH CHECK
        ===================================================== */

        auth.onAuthStateChanged((user) => {

            if (!user) {

                window.location.href =
                    "index.html";

                return;
            }

            document.getElementById(
                "adminEmail"
            ).innerText =
                user.email || "Authenticated user";

            loadPhotos();

        });


        /* =====================================================
           NAVIGATION
        ===================================================== */

        sideLinks.forEach((link) => {

            link.addEventListener("click", () => {

                const sectionName =
                    link.dataset.section;

                sideLinks.forEach((item) =>
                    item.classList.remove("active")
                );

                link.classList.add("active");


                sections.forEach((section) =>
                    section.classList.remove("active")
                );


                const target =
                    document.getElementById(
                        `section-${sectionName}`
                    );

                if (target) {
                    target.classList.add("active");
                }


                const titles = {
                    dashboard: "Overview",
                    upload: "Upload Frame",
                    library: "Photo Library",
                    analytics: "Analytics"
                };

                pageTitle.innerText =
                    titles[sectionName] ||
                    "Studio";


                document.body.classList.remove(
                    "sidebar-open"
                );

            });

        });


        /* =====================================================
           MOBILE MENU
        ===================================================== */

        document
            .getElementById("mobileMenu")
            .addEventListener("click", () => {

                document.body.classList.toggle(
                    "sidebar-open"
                );

            });


        /* =====================================================
           GO UPLOAD
        ===================================================== */

        document
            .getElementById("goUpload")
            .addEventListener("click", () => {

                document
                    .querySelector(
                        '[data-section="upload"]'
                    )
                    .click();

            });


        /* =====================================================
           FILE PICKER
        ===================================================== */

        choosePhoto.addEventListener(
            "click",
            () => photoInput.click()
        );


        photoInput.addEventListener(
            "change",
            (event) => {

                const file =
                    event.target.files[0];

                if (file) {
                    handleSelectedFile(file);
                }

            }
        );


        /* =====================================================
           DRAG & DROP
        ===================================================== */

        dropzone.addEventListener(
            "dragover",
            (event) => {

                event.preventDefault();

                dropzone.classList.add(
                    "dragover"
                );

            }
        );


        dropzone.addEventListener(
            "dragleave",
            () => {

                dropzone.classList.remove(
                    "dragover"
                );

            }
        );


        dropzone.addEventListener(
            "drop",
            (event) => {

                event.preventDefault();

                dropzone.classList.remove(
                    "dragover"
                );


                const file =
                    event.dataTransfer.files[0];

                if (file) {
                    handleSelectedFile(file);
                }

            }
        );


        /* =====================================================
           SELECT FILE
        ===================================================== */

        function handleSelectedFile(file) {

            if (!file.type.startsWith("image/")) {

                showToast(
                    "Please select an image file."
                );

                return;
            }


            const maxSize =
                15 * 1024 * 1024;


            if (file.size > maxSize) {

                showToast(
                    "Image must be smaller than 15 MB."
                );

                return;
            }


            selectedFile = file;


            const reader =
                new FileReader();


            reader.onload = (event) => {

                previewImage.src =
                    event.target.result;

                previewArea.classList.add(
                    "show"
                );

            };


            reader.readAsDataURL(file);


            showToast(
                "Frame selected."
            );

        }


        /* =====================================================
           UPLOAD FORM
        ===================================================== */

        uploadForm.addEventListener(
            "submit",
            async (event) => {

                event.preventDefault();


                if (!selectedFile) {

                    showToast(
                        "Please choose a photo first."
                    );

                    return;
                }


                const category =
                    document.getElementById(
                        "photoCategory"
                    ).value;


                if (!category) {

                    showToast(
                        "Please select a category."
                    );

                    return;
                }


                publishBtn.disabled = true;

                publishBtn.innerText =
                    "UPLOADING FRAME...";


                try {

                    /* -----------------------------------------
                       CLOUDINARY UPLOAD
                    ----------------------------------------- */

                    const formData =
                        new FormData();

                    formData.append(
                        "file",
                        selectedFile
                    );

                    formData.append(
                        "upload_preset",
                        CLOUDINARY_PRESET
                    );

                    formData.append(
                        "folder",
                        `photos/${category}`
                    );


                    const response =
                        await fetch(
                            CLOUDINARY_URL,
                            {
                                method: "POST",
                                body: formData
                            }
                        );


                    const cloudinaryData =
                        await response.json();


                    if (
                        !cloudinaryData.secure_url
                    ) {

                        throw new Error(
                            cloudinaryData.error
                                ? cloudinaryData.error.message
                                : "Cloudinary upload failed."
                        );

                    }


                    /* -----------------------------------------
                       FIRESTORE
                    ----------------------------------------- */

                    await db
                        .collection("photos")
                        .add({

                            url:
                                cloudinaryData.secure_url,

                            title:
                                document.getElementById(
                                    "photoTitle"
                                ).value.trim() ||
                                "Untitled Frame",

                            category:
                                category,

                            location:
                                document.getElementById(
                                    "photoLocation"
                                ).value.trim(),

                            year:
                                document.getElementById(
                                    "photoYear"
                                ).value.trim(),

                            story:
                                document.getElementById(
                                    "photoStory"
                                ).value.trim(),

                            featured:
                                document.getElementById(
                                    "featuredPhoto"
                                ).checked,

                            views: 0,

                            downloads: 0,

                            timestamp:
                                firebase.firestore
                                    .FieldValue
                                    .serverTimestamp()

                        });


                    showToast(
                        "Frame published successfully."
                    );


                    resetUploadForm();

                    await loadPhotos();


                } catch (error) {

                    console.error(error);

                    showToast(
                        "Upload failed: " +
                        error.message
                    );

                } finally {

                    publishBtn.disabled =
                        false;

                    publishBtn.innerText =
                        "PUBLISH FRAME";

                }

            }
        );


        /* =====================================================
           RESET FORM
        ===================================================== */

        function resetUploadForm() {

            selectedFile = null;

            uploadForm.reset();

            previewArea.classList.remove(
                "show"
            );

            previewImage.src = "";

            photoInput.value = "";

        }


        /* =====================================================
           LOAD PHOTOS
        ===================================================== */

        async function loadPhotos() {

            try {

                let snapshot;

                try {

                    snapshot =
                        await db
                            .collection("photos")
                            .orderBy(
                                "timestamp",
                                "desc"
                            )
                            .get();

                } catch (error) {

                    snapshot =
                        await db
                            .collection("photos")
                            .get();

                }


                photos = [];

                snapshot.forEach((doc) => {

                    photos.push({
                        id: doc.id,
                        ...doc.data()
                    });

                });


                updateDashboard();

                renderLibrary();

                renderLatest();

                renderAnalytics();

            } catch (error) {

                console.error(
                    "Could not load photos:",
                    error
                );

                showToast(
                    "Could not load photo library."
                );

            }

        }


        /* =====================================================
           DASHBOARD
        ===================================================== */

        function updateDashboard() {

            let totalViews = 0;
            let totalDownloads = 0;
            let featured = 0;


            photos.forEach((photo) => {

                totalViews +=
                    Number(photo.views || 0);

                totalDownloads +=
                    Number(photo.downloads || 0);

                if (photo.featured === true) {
                    featured++;
                }

            });


            document.getElementById(
                "totalPhotos"
            ).innerText =
                photos.length;


            document.getElementById(
                "totalViews"
            ).innerText =
                formatNumber(totalViews);


            document.getElementById(
                "totalDownloads"
            ).innerText =
                formatNumber(totalDownloads);


            document.getElementById(
                "featuredPhotos"
            ).innerText =
                featured;


            document.getElementById(
                "analyticsViews"
            ).innerText =
                formatNumber(totalViews);


            document.getElementById(
                "analyticsDownloads"
            ).innerText =
                formatNumber(totalDownloads);

        }


        /* =====================================================
           LATEST
        ===================================================== */

        function renderLatest() {

            const grid =
                document.getElementById(
                    "latestGrid"
                );


            const latest =
                photos.slice(0, 4);


            if (!latest.length) {

                grid.innerHTML = `
                    <div class="loading">
                        NO FRAMES YET.
                    </div>
                `;

                return;
            }


            grid.innerHTML =
                latest
                    .map(
                        (photo) =>
                            createPhotoCard(
                                photo
                            )
                    )
                    .join("");

        }


        /* =====================================================
           LIBRARY
        ===================================================== */

        function renderLibrary(
            search = ""
        ) {

            const grid =
                document.getElementById(
                    "libraryGrid"
                );


            const query =
                search
                    .toLowerCase()
                    .trim();


            const filtered =
                photos.filter((photo) => {

                    const text =
                        [
                            photo.title,
                            photo.category,
                            photo.location,
                            photo.story
                        ]
                            .join(" ")
                            .toLowerCase();

                    return text.includes(
                        query
                    );

                });


            if (!filtered.length) {

                grid.innerHTML = `
                    <div class="loading">
                        NO MATCHING FRAMES.
                    </div>
                `;

                return;
            }


            grid.innerHTML =
                filtered
                    .map(
                        (photo) =>
                            createPhotoCard(
                                photo
                            )
                    )
                    .join("");

        }


        /* =====================================================
           PHOTO CARD
        ===================================================== */

        function createPhotoCard(photo) {

            const title =
                escapeHTML(
                    photo.title ||
                    "Untitled Frame"
                );


            const category =
                escapeHTML(
                    photo.category ||
                    "nature"
                );


            const imageUrl =
                optimizeImage(
                    photo.url
                );


            return `

                <article
                    class="photo-item"
                    data-id="${photo.id}"
                >

                    <div class="photo-image-wrap">

                        <img
                            src="${escapeAttribute(imageUrl)}"
                            alt="${escapeAttribute(title)}"
                            loading="lazy"
                        >

                        ${
                            photo.featured
                                ? `
                                    <div class="featured-badge">
                                        FEATURED
                                    </div>
                                  `
                                : ""
                        }

                    </div>


                    <div class="photo-details">

                        <div class="photo-name">
                            ${title}
                        </div>

                        <div class="photo-category">
                            ${category}
                        </div>


                        <div class="photo-stats">

                            <span>
                                👁 ${Number(
                                    photo.views || 0
                                )}
                            </span>

                            <span>
                                ↓ ${Number(
                                    photo.downloads || 0
                                )}
                            </span>

                        </div>


                        <div class="photo-actions">

                            <button
                                class="small-btn"
                                onclick="toggleFeatured('${photo.id}', ${photo.featured === true})"
                            >
                                ${
                                    photo.featured
                                        ? "UNFEATURE"
                                        : "FEATURE"
                                }
                            </button>


                            <button
                                class="small-btn delete-btn"
                                onclick="deletePhoto('${photo.id}')"
                            >
                                DELETE
                            </button>

                        </div>

                    </div>

                </article>
            `;
        }


        /* =====================================================
           FEATURE / UNFEATURE
        ===================================================== */

        async function toggleFeatured(
            photoId,
            currentlyFeatured
        ) {

            try {

                await db
                    .collection("photos")
                    .doc(photoId)
                    .update({

                        featured:
                            !currentlyFeatured

                    });


                showToast(
                    currentlyFeatured
                        ? "Removed from Signature Work."
                        : "Added to Signature Work."
                );


                loadPhotos();

            } catch (error) {

                console.error(error);

                showToast(
                    "Could not update featured status."
                );

            }

        }


        /* =====================================================
           DELETE
        ===================================================== */

        async function deletePhoto(
            photoId
        ) {

            const photo =
                photos.find(
                    (item) =>
                        item.id === photoId
                );


            if (!photo) return;


            const confirmed =
                confirm(
                    `Delete "${photo.title || "Untitled Frame"}"?\n\nThis will remove the photo record from the gallery.`
                );


            if (!confirmed) return;


            try {

                await db
                    .collection("photos")
                    .doc(photoId)
                    .delete();


                showToast(
                    "Frame removed from gallery."
                );


                loadPhotos();

            } catch (error) {

                console.error(error);

                showToast(
                    "Could not delete frame."
                );

            }

        }


        /* =====================================================
           ANALYTICS
        ===================================================== */

        function renderAnalytics() {

            const container =
                document.getElementById(
                    "categoryAnalytics"
                );


            const counts = {};


            photos.forEach((photo) => {

                const category =
                    String(
                        photo.category ||
                        "uncategorized"
                    ).toLowerCase();


                counts[category] =
                    (counts[category] || 0) + 1;

            });


            const entries =
                Object.entries(
                    counts
                ).sort(
                    (a, b) =>
                        b[1] - a[1]
                );


            if (!entries.length) {

                container.innerHTML = `
                    <div class="loading">
                        NO DATA YET.
                    </div>
                `;

                return;
            }


            const max =
                Math.max(
                    ...entries.map(
                        (entry) =>
                            entry[1]
                    )
                );


            container.innerHTML =
                entries
                    .map(
                        ([category, count]) => {

                            const percentage =
                                (count / max) * 100;


                            return `

                                <div class="category-row">

                                    <div class="category-name">
                                        ${escapeHTML(category)}
                                    </div>

                                    <div class="bar">
                                        <div
                                            class="bar-fill"
                                            style="width:${percentage}%"
                                        ></div>
                                    </div>

                                    <div class="category-number">
                                        ${count}
                                    </div>

                                </div>

                            `;

                        }
                    )
                    .join("");

        }


        /* =====================================================
           SEARCH
        ===================================================== */

        librarySearch.addEventListener(
            "input",
            (event) => {

                renderLibrary(
                    event.target.value
                );

            }
        );


        /* =====================================================
           LOGOUT
        ===================================================== */

        document
            .getElementById("logoutBtn")
            .addEventListener(
                "click",
                async () => {

                    try {

                        await auth.signOut();

                        window.location.href =
                            "index.html";

                    } catch (error) {

                        console.error(error);

                    }

                }
            );


        /* =====================================================
           TOAST
        ===================================================== */

        function showToast(message) {

            toast.innerText =
                message;

            toast.classList.add(
                "show"
            );


            setTimeout(() => {

                toast.classList.remove(
                    "show"
                );

            }, 3000);

        }


        /* =====================================================
           IMAGE OPTIMIZATION
        ===================================================== */

        function optimizeImage(url) {

            if (!url) return "";

            if (
                !url.includes(
                    "res.cloudinary.com"
                ) ||
                !url.includes("/upload/")
            ) {
                return url;
            }


            return url.replace(
                "/upload/",
                "/upload/q_auto,f_auto,w_700/"
            );

        }


        /* =====================================================
           NUMBER FORMAT
        ===================================================== */

        function formatNumber(number) {

            return Number(
                number || 0
            ).toLocaleString("en-IN");

        }


        /* =====================================================
           SECURITY HELPERS
        ===================================================== */

        function escapeHTML(value) {

            return String(
                value || ""
            )
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        function escapeAttribute(value) {

            return escapeHTML(
                value
            );

        }

    </script>

</body>
</html>
